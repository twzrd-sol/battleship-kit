#!/usr/bin/env bash
# Refuse commits from the shared canonical checkout (on ANY branch), and direct
# commits to main.
#
# Why: with several agents on one machine, the first slip is "staged on main".
# The real failure is broader: an agent edits files in the shared checkout on a
# feature branch, or leaves untracked divergence no hook can see. Guarding only
# the branch name catches the symptom. Guarding the checkout path catches the
# cause. Overrides exist, are loud, and are for emergencies.
#
#   KIT_ALLOW_SHARED_TREE=1 git commit ...
#   KIT_ALLOW_MAIN_COMMIT=1 git commit ...
#
# Install per clone:  bash kit/hooks/install-githooks.sh
# Inert until core.hooksPath points at the hooks directory.
set -euo pipefail

# Where the shared checkout lives: env, then `git config kit.shared-tree`, then $HOME/app.
shared_tree="${KIT_SHARED_TREE_PATH:-$(git config --get kit.shared-tree 2>/dev/null || echo "$HOME/app")}"
repo_toplevel="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
if [[ ! -d "$shared_tree" ]]; then
  echo "pre-commit: the shared-tree guard is INACTIVE: there is no shared checkout at '$shared_tree'. Set it once: git config kit.shared-tree /path/to/shared/checkout (or export KIT_SHARED_TREE_PATH)." >&2
fi
if [[ -n "$repo_toplevel" \
      && "$(realpath -m "$repo_toplevel" 2>/dev/null || echo "$repo_toplevel")" \
      == "$(realpath -m "$shared_tree" 2>/dev/null || echo "$shared_tree")" ]]; then
  if [[ "${KIT_ALLOW_SHARED_TREE:-0}" != "1" ]]; then
    cat >&2 <<MSG
Refusing to commit from the shared canonical checkout:
    $repo_toplevel

This checkout is shared by every agent on the machine and may serve
production. Committing here bypasses the worktree + PR gate.

Do this instead:
  git fetch origin main
  git worktree add -b <agent>/<task> $HOME/worktrees/<task> origin/main
  cd $HOME/worktrees/<task>
  # move changes from the shared tree as a patch, then commit, push, open a PR

Emergency only:  KIT_ALLOW_SHARED_TREE=1 git commit -m "..."
MSG
    exit 1
  fi
  echo "WARNING: allowing commit from the shared checkout (KIT_ALLOW_SHARED_TREE=1)" >&2
fi

current_branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
  if [[ "${KIT_ALLOW_MAIN_COMMIT:-0}" != "1" ]]; then
    echo "Refusing to commit directly to '$current_branch'. Use a branch and a PR." >&2
    echo "Emergency only:  KIT_ALLOW_MAIN_COMMIT=1 git commit -m \"...\"" >&2
    exit 1
  fi
  echo "WARNING: allowing direct commit to $current_branch (KIT_ALLOW_MAIN_COMMIT=1)" >&2
fi
